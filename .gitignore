tags

# PicoClaw workspace (not synced)
.picoclaw/workspace/

# Repo/local workflow
worktrees/
.specstory/
.tmuxinator.yml
.agents/

.cache/
.local/
# .local/ is ignored wholesale, but EasyEffects hardcodes its preset dir to
# ~/.local/share/easyeffects and has no configurable path. So re-include just
# the input/output preset folders here (the tracked source of truth) by walking
# the path back in; everything else under .local/ stays ignored.
!.local/
.local/*
!.local/share/
.local/share/*
!.local/share/easyeffects/
.local/share/easyeffects/*
!.local/share/easyeffects/input/
!.local/share/easyeffects/output/

# Source trees and project artifacts
Source/

# Personal top-level directories
Documents/
Downloads/
Pictures/
Programs/
Templates/
Videos/

# Shell/history/runtime noise
.bash_history
.python_history
.psql_history
.sqlite_history
.rdbg_history
.irb_history
.irb-history
.zsh_history
.zcompdump

# Local machine/app state
.Xauthority
.fehbg
# .claude/ is mostly local state (sessions, history, caches, credentials), but
# the config, hook scripts and themes are the tracked source of truth. Walk the
# path back in the same way as .local/share/easyeffects above.
!.claude/
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/themes/
.claude.json
.pi/
.cursor/

# Secrets / machine-local material
.ssh/*
!.ssh/config
.gnupg/
.aws/
.kube/
.docker/

# Browser / large local app profiles
.mozilla/
.librewolf/
.config/chromium/
.config/google-chrome/
.config/google-chrome-for-testing/
.config/Signal/
.config/Slack/
.config/discord/
