#!/usr/bin/env bash

set -euo pipefail

function main() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      die "Unknown option: $1"
      ;;
    *)
      break
      ;;
    esac
  done

  [[ $# -gt 0 ]] || die "A command is required"
  command -v systemd-inhibit >/dev/null 2>&1 || die "systemd-inhibit is required"

  exec systemd-inhibit \
    --what=sleep \
    --mode=block \
    --who=wakey \
    --why="Command running under wakey" \
    -- "$@"
}

usage() {
  cat <<EOF
Usage: $(basename "$0") [--] COMMAND [ARG...]

Run a command while preventing the system from sleeping.

Options:
  -h, --help    Show this help message
EOF
}

die() {
  echo "Error: $1" >&2
  exit "${2:-1}"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
