#!/usr/bin/env bash

set -euo pipefail

function main() {
  command -v hyprctl >/dev/null 2>&1 || die "hyprctl is required"
  command -v jq >/dev/null 2>&1 || die "jq is required"
  command -v notify-send >/dev/null 2>&1 || die "notify-send is required"

  local workspace layout next
  workspace="$(hyprctl activeworkspace -j | jq -r '.id')"
  layout="$(hyprctl activeworkspace -j | jq -r '.tiledLayout')"

  if [[ "$layout" == "scrolling" ]]; then
    next="dwindle"
  else
    next="scrolling"
  fi

  hyprctl eval "hl.workspace_rule({ workspace = \"$workspace\", layout = \"$next\" })"
  notify-send --app-name=Hyprland "Workspace $workspace layout" "$next"
}

usage() {
  cat <<EOF
Usage: $(basename "$0")

Toggle the active workspace between the scrolling and dwindle layouts.
EOF
  exit 0
}

die() {
  echo "Error: $1" >&2
  exit "${2:-1}"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
