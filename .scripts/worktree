#!/usr/bin/env bash

set -euo pipefail

function main() {
  [[ $# -gt 0 ]] || { usage; exit 1; }

  local command="$1"
  shift

  case "$command" in
  new) new_worktree "$@" ;;
  create) create_worktree "$@" ;;
  root) worktrees_root ;;
  path) worktree_path_command "$@" ;;
  list) list_worktrees ;;
  setup) setup_worktree "$@" ;;
  diff) diff_worktree "$@" ;;
  destroy) destroy_worktree "$@" ;;
  open) open_worktree "$@" ;;
  -h | --help) usage ;;
  *) die "Unknown command: $command" ;;
  esac
}

usage() {
  cat <<EOF
Usage: worktree COMMAND [OPTIONS]

Commands:
  new "FEATURE"                    Create a dated worktree from a description
  create NAME [--branch BRANCH]   Create a named worktree and branch
  root                            Print the configured worktree root
  path NAME                       Print the path for a named worktree
  list                            Print configured names and paths as TSV
  setup NAME                      Run bin/worktree create in a worktree
  diff NAME                       Open nvim Diffview against the main branch
  destroy NAME [--force]          Remove a worktree
  open NAME                       Open a worktree using the tmuxinator template

Repository-local configuration:
  git config worktree-manager.root ../worktrees
  git config worktree-manager.prefix core-

Environment overrides:
  WORKTREE_ROOT                   Worktree root, absolute or relative to repo
  WORKTREE_PREFIX                 Prefix added to each worktree directory
EOF
}

die() {
  echo "Error: $1" >&2
  exit "${2:-1}"
}

new_worktree() {
  [[ $# -eq 1 ]] || die "'new' requires one quoted feature description"

  local text="$1" slug
  text="${text// /-}"
  slug="$(printf '%s' "$text" | tr '[:upper:]' '[:lower:]' | tr -cd '[:alnum:]-')"
  [[ -n "$slug" ]] || die "Feature description produced an empty name"

  create_worktree "$(date +'%y-%m')-$slug"
}

create_worktree() {
  local name="" branch="" base=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --branch) branch="${2:?Error: --branch requires a value}"; shift 2 ;;
    --base) base="${2:?Error: --base requires a value}"; shift 2 ;;
    -*) die "Unknown option: $1" ;;
    *)
      [[ -z "$name" ]] || die "Unexpected argument: $1"
      name="$1"
      shift
      ;;
    esac
  done

  [[ -n "$name" ]] || die "'create' requires a name"
  assert_name "$name"

  local repo path
  repo="$(repo_root)"
  path="$(worktree_path "$repo" "$name")"
  branch="${branch:-$name}"
  base="${base:-$(main_branch "$repo")}"

  git check-ref-format --branch "$branch" >/dev/null 2>&1 ||
    die "Invalid branch name: $branch"
  [[ ! -e "$path" ]] || die "Worktree already exists: $path"

  mkdir -p "$(dirname "$path")"
  if git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$repo" worktree add "$path" "$branch" ||
      die "git worktree add failed"
  else
    git -C "$repo" worktree add -b "$branch" "$path" "$base" ||
      die "git worktree add failed"
  fi
  echo "Created worktree: $path"

  setup_worktree "$name"
}

worktrees_root() {
  local repo
  repo="$(repo_root)"
  configured_root "$repo"
}

worktree_path_command() {
  [[ $# -eq 1 ]] || die "'path' requires a name"
  assert_name "$1"

  local repo
  repo="$(repo_root)"
  worktree_path "$repo" "$1"
}

configured_root() {
  local repo="$1" root
  root="${WORKTREE_ROOT:-}"
  if [[ -z "$root" ]]; then
    root="$(git -C "$repo" config --local --get worktree-manager.root 2>/dev/null || true)"
  fi
  root="${root:-$repo/worktrees}"

  if [[ "$root" != /* ]]; then
    root="$repo/$root"
  fi
  realpath -m "$root"
}

configured_prefix() {
  local repo="$1" prefix
  if [[ "${WORKTREE_PREFIX+x}" == x ]]; then
    prefix="$WORKTREE_PREFIX"
  else
    prefix="$(git -C "$repo" config --local --get worktree-manager.prefix 2>/dev/null || true)"
  fi
  printf '%s' "$prefix"
}

worktree_path() {
  local repo="$1" name="$2"
  printf '%s/%s%s\n' "$(configured_root "$repo")" "$(configured_prefix "$repo")" "$name"
}

list_worktrees() {
  local repo root prefix line path directory name
  repo="$(repo_root)"
  root="$(configured_root "$repo")"
  prefix="$(configured_prefix "$repo")"

  while IFS= read -r line; do
    [[ "$line" == "worktree "* ]] || continue
    path="${line#worktree }"
    [[ "$path" == "$root/"* ]] || continue
    directory="$(basename "$path")"
    [[ "$directory" == "$prefix"* ]] || continue
    name="${directory#"$prefix"}"
    [[ -n "$name" ]] && printf '%s\t%s\n' "$name" "$path"
  done < <(git -C "$repo" worktree list --porcelain)
}

setup_worktree() {
  [[ $# -eq 1 ]] || die "'setup' requires a worktree name"
  local path script
  path="$(worktree_path_command "$1")"
  [[ -d "$path" ]] || die "Worktree does not exist: $path"

  script="$(repo_hook "$path")"

  if [[ -n "$script" ]]; then
    echo "Running setup in $path..."
    (cd "$path" && "$script" create)
  else
    echo "No executable setup script found at $path/bin/worktree"
  fi
}

repo_hook() {
  local path="$1" script main_checkout

  script="$path/bin/worktree"
  if [[ ! -x "$script" ]]; then
    main_checkout="$(dirname "$(git -C "$path" rev-parse --path-format=absolute --git-common-dir)")"
    script="$main_checkout/bin/worktree"
  fi

  [[ -x "$script" ]] && echo "$script"
  return 0
}

diff_worktree() {
  [[ $# -eq 1 ]] || die "'diff' requires a worktree name"
  command -v nvim >/dev/null 2>&1 || die "nvim is not installed"

  local repo path base
  repo="$(repo_root)"
  path="$(worktree_path "$repo" "$1")"
  base="$(main_branch "$repo")"
  [[ -d "$path" ]] || die "Worktree does not exist: $path"

  if ! git -C "$path" diff --quiet || ! git -C "$path" diff --cached --quiet; then
    (cd "$path" && nvim -c "DiffviewOpen")
  elif ! git -C "$path" diff --quiet "refs/heads/$base" --; then
    (cd "$path" && nvim -c "DiffviewOpen $base")
  else
    echo "No changes to diff against $base"
  fi
}

destroy_worktree() {
  local name="" force=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --force) force=true; shift ;;
    -*) die "Unknown option: $1" ;;
    *)
      [[ -z "$name" ]] || die "Unexpected argument: $1"
      name="$1"
      shift
      ;;
    esac
  done

  [[ -n "$name" ]] || die "'destroy' requires a worktree name"
  assert_name "$name"

  local repo root path resolved
  repo="$(repo_root)"
  root="$(configured_root "$repo")"
  path="$(worktree_path "$repo" "$name")"
  [[ -d "$path" ]] || die "Worktree does not exist: $path"

  resolved="$(realpath "$path")"
  [[ "$resolved" == "$root/"* ]] || die "Refusing to remove path outside $root: $resolved"

  local hook
  hook="$(repo_hook "$path")"
  if [[ -n "$hook" ]]; then
    echo "Running cleanup in $path..."
    (cd "$path" && "$hook" destroy) ||
      die "Cleanup failed; worktree retained: $path"
  fi

  local -a args=()
  [[ "$force" == true ]] && args=(--force)
  git -C "$repo" worktree remove "${args[@]}" "$path" ||
    die "git worktree remove failed"
}

open_worktree() {
  [[ $# -eq 1 ]] || die "'open' requires a worktree name"
  command -v tmuxinator >/dev/null 2>&1 || die "tmuxinator is not installed"

  local path
  path="$(worktree_path_command "$1")"
  [[ -d "$path" ]] || die "Worktree does not exist: $path"
  tmuxinator start --append worktree "$(basename "$path")" "$path"
}

assert_name() {
  local name="$1"
  [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]] ||
    die "Invalid name: $name (lowercase letters, digits and hyphens only)"
}

repo_root() {
  git rev-parse --show-toplevel 2>/dev/null || die "Not inside a git repository"
}

main_branch() {
  local repo="$1" branch
  branch="$(git -C "$repo" symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null |
    sed 's@^refs/remotes/origin/@@')" || true
  [[ -n "$branch" ]] && { echo "$branch"; return; }
  git -C "$repo" show-ref --verify --quiet refs/heads/main && { echo main; return; }
  git -C "$repo" show-ref --verify --quiet refs/heads/master && { echo master; return; }
  echo main
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
